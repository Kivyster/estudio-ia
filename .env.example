# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.
# Todas as chaves abaixo são gratuitas e não pedem cartão. Preencha as que tiver (mínimo 1; Gemini é a mais importante).
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
# opcional, PAGO (barato, sem plano grátis): reserva em todos os cargos
DEEPSEEK_API_KEY=
# opcional: qualquer API compatível com OpenAI como reserva (veja docs/CONFIGURACAO.md)
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
# opcional: pesquisa na web do cargo Pesquisador (https://tavily.com, plano grátis)
TAVILY_API_KEY=
# opcional: controle e avisos pelo Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# token do GitHub só do repositório de assets (Contents: Read and write). O setup pede quando precisar.
GITHUB_ASSETS_TOKEN=
# gerados sozinhos pelo setup (pode deixar em branco)
ESTUDIO_KEY=
HUB_SENHA=
